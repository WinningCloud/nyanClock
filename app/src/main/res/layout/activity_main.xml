<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.farhan.nyanclock.MainActivity"
    android:background="#043163"
    >

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/container"
        android:orientation="vertical"
        android:onClick="onWrongClick"
        >



        <ImageButton
            android:id="@+id/star_button"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:visibility="invisible"
            android:layout_gravity="center"
            android:layout_marginBottom="120dp"
            android:background="@null"
            android:onClick="onClickStar"
            android:scaleType="centerCrop"
            android:src="@drawable/star" />


        <TextView
            android:id="@+id/heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center|top"
            android:text="GOAL: NYA FOR 6389 SECONDS!!"
            android:textColor="#FFFFFF"
            android:textSize="25dp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/timetext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"

            android:text="0"
            android:textColor="#00F2D8D8"
            android:textSize="150dp"
            android:textStyle="bold" />

        <ImageView

        android:layout_marginTop="40dp"
        android:id="@+id/nyanCat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/nyan_cat_gif"
        android:layout_gravity="center"
        />

        <TextView
            android:id="@+id/stars_count"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="130dp"
            android:fontFamily="@font/pixelify_sans"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageButton
            android:layout_width="200dp"
            android:layout_height="120dp"
            android:src="@drawable/start"
            android:scaleType="fitCenter"
            android:layout_gravity="center|bottom"
            android:id="@+id/button"
            android:onClick="onClickButton"
            android:background="@null"/>
        <ImageButton
            android:layout_width="40dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:scaleType="centerCrop"
            android:layout_height="40dp"
            android:src="@drawable/help"
            android:layout_gravity="bottom|end"
            android:id="@+id/help_button"
            android:onClick="onClickHelp"
            android:background="@null"/>
        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="5dp"
            android:onClick="onClickConnect"
            android:id="@+id/connect_button"
            android:background="@null"
            android:scaleType="centerCrop"
            android:layout_gravity="end|bottom"
            android:layout_marginBottom="55dp"
            android:src="@drawable/connect"/>

        <LinearLayout
            android:layout_gravity="center|end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:orientation="vertical">
            <ImageView
                android:layout_gravity="center|end"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:id="@+id/heart1"
                android:src="@drawable/heart"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center|end"
                android:layout_width="40dp"
                android:id="@+id/heart2"
                android:layout_height="40dp"
                android:src="@drawable/heart"
                android:scaleType="centerCrop"/>
            <ImageView
                android:layout_gravity="center|end"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:id="@+id/heart3"
                android:src="@drawable/heart"
                android:scaleType="centerCrop"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ufo_view"
            android:layout_width="151dp"
            android:layout_height="130dp"
            android:layout_gravity="start|top"
            android:background="@null"
            android:onClick="onClickUfo"
            android:rotation="24"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:visibility="invisible"
            android:focusable="true"
            android:src="@drawable/ufo" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>