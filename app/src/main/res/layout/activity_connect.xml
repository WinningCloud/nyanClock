<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#3F51B5"
    android:layout_height="match_parent"
    >

    <TextView
        android:layout_marginTop="30dp"
        android:padding="0dp"
        android:id="@+id/textView4"
        android:layout_gravity="center|top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pixelify_sans"
        android:gravity="center_horizontal"
        android:text="Connect with me on: "
        android:textColor="@color/white"
        android:textSize="40dp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="-16dp" />

    <LinearLayout

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        >
    <LinearLayout
        android:layout_marginTop="30dp"
        android:id="@+id/linearLayout6"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:onClick="onClickInsta"
        android:orientation="horizontal"
        >


        <ImageButton
            android:layout_width="50dp"

            android:layout_height="50dp"
            android:layout_gravity="center"
            android:background="@null"

            android:scaleType="centerCrop"

            android:src="@drawable/insta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans"
            android:text="\  @farhann_6389"
            android:textColor="#00BCD4"
            android:textSize="40dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="30dp"
        android:id="@+id/linearLayout5"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/white"
        android:onClick="onClickGit"
        android:orientation="horizontal"
        >


        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:background="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/github" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans"
            android:text="\  @WinningCloud"
            android:textColor="#00BCD4"
            android:textSize="40dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="30dp"
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_gravity="center|bottom"
        android:onClick="onClickLin"
        android:orientation="horizontal"
        >


        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:background="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/linkedin" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans"
            android:text="\  Farhan Md"
            android:textColor="#00BCD4"
            android:textSize="40dp" />

    </LinearLayout>
    </LinearLayout>

</FrameLayout>